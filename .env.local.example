# === Supabase API (Auth, Storage, client browser) ===
NEXT_PUBLIC_SUPABASE_URL=https://bliahoxuauowpvlpzcrf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Wajib untuk upload bukti/logo dari Server Action (Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# === Prisma → Postgres (dari Dashboard → Project Settings → Database) ===
# Session mode / Transaction pooler (port 6543) — untuk runtime app
DATABASE_URL="postgresql://postgres.bliahoxuauowpvlpzcrf:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — untuk prisma migrate / db push
DIRECT_URL="postgresql://postgres.bliahoxuauowpvlpzcrf:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
