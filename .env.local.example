# === Supabase API (Auth, Storage, client browser) ===
NEXT_PUBLIC_SUPABASE_URL=https://REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Wajib untuk upload bukti/logo dari Server Action (Dashboard → Settings → API Keys → service_role)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# === Prisma → Postgres (Connect → Prisma / URI; region Singapore) ===
# Transaction pooler (port 6543) — runtime app
DATABASE_URL="postgresql://postgres.REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432) — prisma migrate / db push (direct db.* sering diblokir ISP)
DIRECT_URL="postgresql://postgres.REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
